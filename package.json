{
  "name": "dsh-prompt-presets",
  "version": "0.1.0",
  "description": "提示词模板库 + 任务完成提醒 (prompt templates + task completion alerts) for DeepSeek Harness Web GUI — static Cordis plugin bundle (host + client halves)",
  "type": "module",
  "license": "MIT",
  "main": "bundle/host.js",
  "exports": {
    ".": "./bundle/host.js",
    "./client": "./bundle/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bundle",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "prompt-templates",
    "notification"
  ]
}
